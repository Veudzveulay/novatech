# Valeurs entièrement fictives : ne pas utiliser pour un déploiement réel.
project_name       = "example-project"
environment        = "production"
aws_region         = "eu-west-3"
vpc_cidr           = "10.20.0.0/16"
availability_zones = ["eu-west-3a", "eu-west-3b"] # Exemple fictif, zones à confirmer.
public_subnet_cidrs = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]
budget_limit_eur    = 40
image_uris = {
  frontend     = "000000000000.dkr.ecr.eu-west-3.amazonaws.com/example-project/frontend:sha-example"
  api-gateway  = "000000000000.dkr.ecr.eu-west-3.amazonaws.com/example-project/api-gateway:sha-example"
  auth         = "000000000000.dkr.ecr.eu-west-3.amazonaws.com/example-project/auth:sha-example"
  paie         = "000000000000.dkr.ecr.eu-west-3.amazonaws.com/example-project/paie:sha-example"
  conges       = "000000000000.dkr.ecr.eu-west-3.amazonaws.com/example-project/conges:sha-example"
  recrutement  = "000000000000.dkr.ecr.eu-west-3.amazonaws.com/example-project/recrutement:sha-example"
}
db_name                    = "novatechproduction"
db_username                = "production_admin"
db_instance_class          = "db.t4g.micro"
db_allocated_storage       = 20
db_backup_retention_period = 7
db_deletion_protection     = true
db_skip_final_snapshot     = false
