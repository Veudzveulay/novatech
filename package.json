{
  "name": "novatech-hrflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev": "node services/api-gateway/src/server.js",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:coverage:unit": "jest --selectProjects unit --coverage",
    "test:e2e": "playwright test",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "devDependencies": {
    "@playwright/test": "1.44.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
