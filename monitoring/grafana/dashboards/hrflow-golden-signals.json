{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "HRFlow — 4 Golden Signals",
  "uid": "hrflow-golden-signals",
  "tags": ["hrflow", "golden-signals"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environnement",
        "type": "custom",
        "query": "staging,production",
        "current": { "text": "staging", "value": "staging" },
        "options": [
          { "text": "staging", "value": "staging", "selected": true },
          { "text": "production", "value": "production", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilité des services (up)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "targets": [
        { "expr": "up{job=\"hrflow-services\", env=\"$env\"}", "legendFormat": "{{service}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Trafic — requêtes/s par service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{env=\"$env\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Erreurs — % de réponses 5xx",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] }
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{status_code=~\"5..\", env=\"$env\"}[5m])) / sum by (service) (rate(http_requests_total{env=\"$env\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latence — P99 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(http_request_duration_seconds_bucket{env=\"$env\"}[5m])))",
          "legendFormat": "{{service}} p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Saturation — lag event loop (s) & mémoire (Mo)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds{env=\"$env\"}",
          "legendFormat": "{{service}} lag",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes{env=\"$env\"} / 1024 / 1024",
          "legendFormat": "{{service}} RSS (Mo)",
          "refId": "B"
        }
      ]
    }
  ]
}
